# Valores locais de exemplo. Nenhum é segredo real.
# Copie para .env e ajuste se necessário: cp .env.example .env

# --- Aplicação (cmd/api) -----------------------------------------------------
HTTP_ADDR=:8080
LOG_LEVEL=info
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=20s            # prazo global do encerramento
SHUTDOWN_DRAIN_TIMEOUT=12s      # drenagem; o restante (8s) é a reserva para cancelar, limpar e fechar dependências

# Referências pendentes e worker (padrões aprovados; nos testes usam-se valores bem menores)
REFERENCE_TTL=15m
REFERENCE_BACKOFF_INITIAL=1s
REFERENCE_BACKOFF_MAX=30s
REFERENCE_POLL_INTERVAL=1s
REFERENCE_PHASE_TIMEOUT=10s
REFERENCE_WORKERS=1

# Papel de RUNTIME (sem posse das tabelas, sem superusuário, sem UPDATE/DELETE no ledger).
# É criado por `migrate up` quando RUNTIME_DB_ROLE está definido (abaixo).
DATABASE_URL=postgres://wager_app:wager_app_dev_password@localhost:5433/wager?sslmode=disable
DB_MAX_CONNS=10

# --- Migrations (cmd/migrate): papel DONO do schema -----------------------------
MIGRATE_DATABASE_URL=postgres://wager:wager@localhost:5433/wager?sslmode=disable
RUNTIME_DB_ROLE=wager_app
RUNTIME_DB_PASSWORD=wager_app_dev_password

# issuer = valor da claim "iss" escrita pelo Keycloak (host público);
# JWKS = de onde a aplicação busca as chaves públicas (na rede do Compose seria http://keycloak:8080/...).
OIDC_ISSUER=http://localhost:8081/realms/wager
OIDC_JWKS_URL=http://localhost:8081/realms/wager/protocol/openid-connect/certs
OIDC_AUDIENCE=wager-api
OIDC_CLOCK_SKEW=5s

# --- Broker (MiniStack 1.5.27, AUTH=true) -----------------------------------------------
# A aplicação usa o principal de RUNTIME do broker pela cadeia padrão do SDK: um perfil do arquivo de
# credenciais escrito pelo provisionamento (`docker compose run --rm broker-provision`). Chaves AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY no ambiente prevaleceriam sobre o perfil: não as defina. São credenciais SINTÉTICAS locais.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_SHARED_CREDENTIALS_FILE=.local/broker/credentials
AWS_PROFILE=wager-runtime
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
# Só o provisionamento e a prova usam o principal administrador (a raiz do emulador); nunca a aplicação.
BROKER_ADMIN_ACCESS_KEY_ID=test
BROKER_ADMIN_SECRET_ACCESS_KEY=test
BROKER_CREDENTIALS_FILE=.local/broker/credentials
# Compose: diretório do host onde o provisionamento escreve as credenciais (use outro numa verificação isolada).
# BROKER_DIR=./.local/broker

ALLOWED_CURRENCIES=BRL

# --- Portas publicadas pelo docker compose ------------------------------------
POSTGRES_PORT=5433
KEYCLOAK_PORT=8081
BROKER_PORT=4566
API_PORT=8080

# --- Identidades de teste provisionadas no Keycloak (deploy/keycloak/wager-realm.json) ---
KEYCLOAK_TOKEN_URL=http://localhost:8081/realms/wager/protocol/openid-connect/token
INTERNAL_CLIENT_ID=internal-service
INTERNAL_CLIENT_SECRET=internal-service-dev-secret
PROVIDER_A_CLIENT_ID=provider-a
PROVIDER_A_CLIENT_SECRET=provider-a-dev-secret
PROVIDER_B_CLIENT_ID=provider-b
PROVIDER_B_CLIENT_SECRET=provider-b-dev-secret

# --- Testes de integração (build tag "integration") --------------------------
# Banco de teste (papel dono). Qualquer nome serve, desde que NÃO seja o banco da aplicação:
# a suíte recria o schema nele a cada execução e só aceita um banco vazio ou já marcado como
# de teste (COMMENT ON DATABASE). Bancos auxiliares ganham sufixo aleatório e são removidos.
TEST_DATABASE_URL=postgres://wager:wager@localhost:5433/wager_test?sslmode=disable
# Papel de runtime PRÓPRIO da suíte (os papéis são do servidor inteiro: não reutilize o da aplicação,
# senão a suíte trocaria a senha dele). Usado pela aplicação sob teste.
TEST_RUNTIME_DB_ROLE=wager_test_app
TEST_RUNTIME_DB_PASSWORD=wager_test_app
